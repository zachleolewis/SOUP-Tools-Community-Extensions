{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/zachleolewis/SOUP-Tools-Community-Extensions/schema/extensions.schema.json",
  "title": "SOUP Tools community extensions",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "author", "description", "repo"],
    "properties": {
      "id": {
        "type": "string",
        "description": "The manifest id: 1 to 40 lowercase letters, digits and dashes, no leading or trailing dash, not starting with 'soup'.",
        "pattern": "^(?!soup)[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$"
      },
      "name": { "type": "string", "minLength": 1, "maxLength": 60 },
      "author": { "type": "string", "minLength": 1, "maxLength": 100 },
      "description": { "type": "string", "minLength": 1, "maxLength": 250 },
      "repo": {
        "type": "string",
        "description": "GitHub owner/name.",
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9._-]{1,100}$"
      },
      "official": { "type": "boolean" }
    }
  }
}
